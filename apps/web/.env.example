# Copie para apps/web/.env.local (ignorado pelo git) e preencha.
# Área de spawn pessoal: um círculo com 3 Pokémon simulados, para jogar fora do campus.
# Pegue as coordenadas no Google Maps: toque e segure no local → copie "-23.xxxxx, -50.xxxxx".
# Não commite coordenadas da sua casa.
VITE_PERSONAL_AREA_LAT=
VITE_PERSONAL_AREA_LNG=
VITE_PERSONAL_AREA_RADIUS_METERS=60
VITE_PERSONAL_AREA_NAME=Minha casa
